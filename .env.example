# ============================================================
# LAVÔ — Environment Variables Template
# Copy this file as .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ------------------------------------------------------------
# Supabase (required)
# Get these at: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER expose on the client side, server only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# Asaas — Payment gateway (required for payment processing)
# Get at: https://www.asaas.com/cadastro
# ------------------------------------------------------------
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENV=sandbox   # sandbox | production

# ------------------------------------------------------------
# Google Maps (optional — enhances location features)
# Get at: https://console.cloud.google.com/
# ------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ------------------------------------------------------------
# App URLs
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
